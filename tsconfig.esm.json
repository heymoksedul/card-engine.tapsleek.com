{
  // ES-module build for browser bundlers (the s1 preview runtime). Only
  // reachable through the custom "tapsleek-esm" export condition, so every
  // existing consumer keeps resolving the CommonJS build in dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": false,
    "outDir": "./dist-esm"
  },
  // Unlike the CJS build, compile the *.esm.tsx browser variants too
  // (scripts/postbuild-esm.js swaps them in).
  "exclude": ["node_modules", "dist", "dist-esm", "src/**/*.spec.ts"]
}
